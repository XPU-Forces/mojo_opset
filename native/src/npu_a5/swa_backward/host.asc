#include "host.h"
#include "common/npu.h"

#include <c10/core/DeviceGuard.h>
#include <torch_npu/csrc/core/npu/NPUCachingAllocator.h>
#include <torch_npu/csrc/core/npu/NPUStream.h>

#include "acl/acl.h"

#include <algorithm>
#include <cmath>
#include <cstdint>
#include <limits>
#include <tuple>

#define SWA_BWD_ENTRY_KERNEL swa_v5_backward_bf16
#define SWA_BWD_ENTRY_IS_CAUSAL 1
#define SWA_BWD_ENTRY_INPUT_TYPE bfloat16_t
#include "kernel/entry.cpp"

namespace mojo::native {
namespace {

constexpr uint32_t kDim = 128U;
constexpr uint64_t kReservedWorkspaceBytes = 16ULL * 1024ULL * 1024ULL;
constexpr uint64_t kDkvScratchSlots = 2ULL;
constexpr uint64_t kDkvGradKinds = 2ULL;
constexpr uint64_t kDkvColorWorkspaceLimitBytes = 96ULL * 1024ULL * 1024ULL;
constexpr uint64_t kDkvColorMqaWorkspaceLimitBytes =
    88ULL * 1024ULL * 1024ULL;
constexpr uint64_t kDkvColorTwoHeadWorkspaceLimitBytes =
    84ULL * 1024ULL * 1024ULL;
constexpr uint64_t kDkvColorLargeGqaWorkspaceLimitBytes =
    80ULL * 1024ULL * 1024ULL;
constexpr uint64_t kDkvColorThreeHeadPackLimitBytes =
    64ULL * 1024ULL * 1024ULL;
constexpr uint64_t kDkvColorSingleHeadWorkspaceLimitBytes =
    512ULL * 1024ULL * 1024ULL;
constexpr uint32_t kDkvColorChunkPromotionRows = 8U * 128U;
constexpr uint32_t kDkvColorChunkPromotionTailRows = 128U;
constexpr uint32_t kDkvColorChunkPromotionMaxWaves = 4U;

uint32_t CubeCoreCount(const at::Tensor &tensor) {
  int64_t cores = 0;
  TORCH_CHECK(aclrtGetDeviceInfo(tensor.device().index(), ACL_DEV_ATTR_CUBE_CORE_NUM, &cores) == ACL_SUCCESS &&
                  cores > 0 && cores <= std::numeric_limits<uint32_t>::max(),
              "failed to query NPU Cube core count");
  return static_cast<uint32_t>(cores);
}

void ValidateC1C2Inputs(const at::Tensor &q, const at::Tensor &k, const at::Tensor &v,
                        const at::Tensor &out, const at::Tensor &dout,
                        const at::Tensor &softmax_lse, const at::Tensor &cu_q_lens,
                        const at::Tensor &cu_kv_lens) {
  TORCH_CHECK(q.device().type() == c10::DeviceType::PrivateUse1, "q must be an NPU tensor");
  TORCH_CHECK(q.device() == k.device() && q.device() == v.device() && q.device() == out.device() &&
                  q.device() == dout.device() && q.device() == softmax_lse.device() &&
                  q.device() == cu_q_lens.device() && q.device() == cu_kv_lens.device(),
              "all tensors must be on the same NPU device");
  TORCH_CHECK(q.is_contiguous() && k.is_contiguous() && v.is_contiguous() &&
                  out.is_contiguous() && dout.is_contiguous() && softmax_lse.is_contiguous(),
              "q/k/v/out/dout/softmax_lse must be contiguous");
  TORCH_CHECK(q.scalar_type() == at::kBFloat16 && k.scalar_type() == at::kBFloat16 &&
                  v.scalar_type() == at::kBFloat16 && dout.scalar_type() == at::kBFloat16 &&
                  softmax_lse.scalar_type() == at::kFloat,
              "q/k/v/dout must be BF16 and softmax_lse must be FP32");
  TORCH_CHECK(out.scalar_type() == at::kBFloat16 || out.scalar_type() == at::kFloat,
              "saved output must be BF16 or FP32");
  TORCH_CHECK(q.dim() == 3 && k.dim() == 3 && v.dim() == 3 && out.dim() == 3 &&
                  dout.dim() == 3, "q/k/v/out/dout must be packed TND tensors");
  TORCH_CHECK(q.sizes() == out.sizes() && q.sizes() == dout.sizes() && k.sizes() == v.sizes(),
              "q/out/dout or k/v shapes differ");
  TORCH_CHECK(q.size(2) == kDim && k.size(2) == kDim, "head_dim must be 128");
  TORCH_CHECK(softmax_lse.numel() == q.size(0) * q.size(1),
              "softmax_lse must contain [q_head, total_q_tokens]");
  TORCH_CHECK(cu_q_lens.scalar_type() == at::kInt && cu_kv_lens.scalar_type() == at::kInt &&
                  cu_q_lens.is_contiguous() && cu_kv_lens.is_contiguous(),
              "cu_lens must be contiguous int32 tensors");
  TORCH_CHECK(cu_q_lens.dim() == 1 && cu_q_lens.sizes() == cu_kv_lens.sizes() &&
                  cu_q_lens.numel() >= 2,
              "cu_lens must be matching one-dimensional tensors");
}

}  // namespace

std::tuple<at::Tensor, at::Tensor, at::Tensor, at::Tensor> LaunchSwaBackwardCurrentStream(
    const at::Tensor &q, const at::Tensor &k, const at::Tensor &v, const at::Tensor &out,
    const at::Tensor &dout, const at::Tensor &softmax_lse, const at::Tensor &cu_q_lens,
    const at::Tensor &cu_kv_lens, int64_t window_left, int64_t gqa_layout,
    int64_t global_window, double scale) {
  ValidateC1C2Inputs(q, k, v, out, dout, softmax_lse, cu_q_lens, cu_kv_lens);
  const c10::DeviceGuard device_guard(q.device());
  TORCH_CHECK(cu_q_lens.numel() - 1 <=
                  static_cast<int64_t>(std::numeric_limits<uint32_t>::max()),
              "batch count must fit uint32");
  TORCH_CHECK(q.size(0) <= std::numeric_limits<uint32_t>::max() &&
                  k.size(0) <= std::numeric_limits<uint32_t>::max() &&
                  q.size(1) <= std::numeric_limits<uint32_t>::max() &&
                  k.size(1) <= std::numeric_limits<uint32_t>::max(),
              "token and head counts must fit uint32");
  const uint32_t batch = static_cast<uint32_t>(cu_q_lens.numel() - 1);
  const uint32_t hq = static_cast<uint32_t>(q.size(1));
  const uint32_t hkv = static_cast<uint32_t>(k.size(1));
  const uint32_t total_q_tokens = static_cast<uint32_t>(q.size(0));
  const uint32_t total_kv_tokens = static_cast<uint32_t>(k.size(0));
  const auto host_cu_q = ReadCuLens(cu_q_lens);
  const auto host_cu_kv =
      cu_q_lens.is_same(cu_kv_lens) ? host_cu_q : ReadCuLens(cu_kv_lens);
  TORCH_CHECK(host_cu_q.front() == 0 && host_cu_kv.front() == 0 &&
                  host_cu_q.back() == q.size(0) && host_cu_kv.back() == k.size(0),
              "cu_lens do not match packed token counts");
  uint32_t max_q_len = 0U;
  uint32_t max_kv_len = 0U;
  uint64_t local_candidate_count = 0U;
  uint64_t kv_group_count = 0U;
  uint64_t q_tail_jobs = 0U;
  for (uint32_t i = 0U; i < batch; ++i) {
    TORCH_CHECK(host_cu_q[i + 1] >= host_cu_q[i] &&
                    host_cu_kv[i + 1] >= host_cu_kv[i],
                "cu_lens must be nondecreasing");
    const uint32_t q_len =
        static_cast<uint32_t>(host_cu_q[i + 1] - host_cu_q[i]);
    const uint32_t kv_len =
        static_cast<uint32_t>(host_cu_kv[i + 1] - host_cu_kv[i]);
    TORCH_CHECK(kv_len >= q_len,
                "each kv sequence must be at least as long as its q sequence");
    if (q_len > 0U) {
      local_candidate_count +=
          ((static_cast<uint64_t>(q_len) + 127U) / 128U) * hkv;
      if (kv_len == q_len) {
        kv_group_count +=
            ((static_cast<uint64_t>(kv_len) + 127U) / 128U) * hkv;
      }
      if (q_len % 128U != 0U) {
        q_tail_jobs += hq;
      }
    }
    max_q_len = std::max(max_q_len, q_len);
    max_kv_len = std::max(max_kv_len, kv_len);
  }
  TORCH_CHECK(hq > 0U && hkv > 0U, "q_heads and kv_heads must be positive");
  TORCH_CHECK(hq % hkv == 0U, "q_heads must be divisible by kv_heads");
  TORCH_CHECK(gqa_layout == 0 || gqa_layout == 1, "invalid GQA layout");
  TORCH_CHECK(window_left >= -1, "window_left must be a radius or -1 for disabled");
  TORCH_CHECK(window_left >= 0 || global_window > 0,
              "a local or global window must be enabled");
  TORCH_CHECK(global_window >= 0, "global window must be non-negative");
  TORCH_CHECK(std::isfinite(scale) && scale > 0.0 &&
                  scale <= std::numeric_limits<float>::max(),
              "softmax scale must be finite, positive, and representable as float");
  // Kernel encoding: 0 disables local; a positive span includes the query itself.
  window_left = window_left < 0 ? 0 :
      std::min<int64_t>(window_left, max_kv_len - 1U) + 1;
  global_window = std::min<int64_t>(global_window, max_kv_len);
  // The query token belongs to the local window only when it is enabled.
  if (global_window >= max_kv_len ||
      (window_left > 0 &&
       static_cast<uint64_t>(window_left) +
               static_cast<uint64_t>(global_window) >=
           max_kv_len)) {
    window_left = max_kv_len;
    global_window = 0;
  }
  const uint64_t local_radius =
      window_left > 0 ? static_cast<uint64_t>(window_left - 1) : 0U;

  auto dq = at::empty_like(q, q.options(), at::MemoryFormat::Contiguous);
  auto dk = at::empty_like(k, k.options(), at::MemoryFormat::Contiguous);
  auto dv = at::empty_like(v, v.options(), at::MemoryFormat::Contiguous);
  const uint64_t dq_elems = static_cast<uint64_t>(q.numel());
  const uint64_t dk_elems = static_cast<uint64_t>(k.numel());
  const uint64_t dv_elems = static_cast<uint64_t>(v.numel());
  const uint64_t dq_storage_elems =
      dq_elems + static_cast<uint64_t>(batch) * 127U * hq * kDim;
  const uint64_t dk_storage_elems =
      dk_elems + static_cast<uint64_t>(batch) * 127U * hkv * kDim;
  const uint64_t dv_storage_elems =
      dv_elems + static_cast<uint64_t>(batch) * 127U * hkv * kDim;
  const uint64_t workspace_elems =
      dq_storage_elems + dk_storage_elems + dv_storage_elems;
  bool has_misaligned_prefix = false;
  for (uint32_t i = 0U; i < batch; ++i) {
    const uint32_t q_len =
        static_cast<uint32_t>(host_cu_q[i + 1] - host_cu_q[i]);
    const uint32_t kv_len =
        static_cast<uint32_t>(host_cu_kv[i + 1] - host_cu_kv[i]);
    has_misaligned_prefix |= (kv_len - q_len) % 128U != 0U;
  }
  const uint64_t max_delta =
      local_radius / 128U + (local_radius % 128U != 0U ? 1U : 0U);
  const uint64_t color_count =
      max_delta + (has_misaligned_prefix ? 2U : 1U);
  const uint64_t color_workspace_limit_elems =
      (hq == 1U && hkv == 1U ?
           kDkvColorSingleHeadWorkspaceLimitBytes :
       hkv == 1U ?
           kDkvColorMqaWorkspaceLimitBytes :
       hkv == 2U ?
           kDkvColorTwoHeadWorkspaceLimitBytes :
       hq > hkv && hkv >= 4U && total_q_tokens == total_kv_tokens ?
           kDkvColorLargeGqaWorkspaceLimitBytes :
           kDkvColorWorkspaceLimitBytes) /
      sizeof(float);
  const uint64_t batch_dk_storage_elems =
      (static_cast<uint64_t>(max_kv_len) + 127U) * hkv * kDim;
  const uint64_t color_chunk_storage_rows =
      color_workspace_limit_elems /
      (2U * color_count * hkv * kDim);
  const uint64_t packed_color_storage_rows =
      hkv == 3U ?
            kDkvColorThreeHeadPackLimitBytes /
                sizeof(float) / (2U * color_count * hkv * kDim) :
          color_chunk_storage_rows;
  const uint64_t color_chunk_usable_rows =
      color_chunk_storage_rows > 127U ?
          color_chunk_storage_rows - 127U : 0U;
  const uint32_t color_chunk_capacity_rows =
      static_cast<uint32_t>(color_chunk_usable_rows / 128U) * 128U;
  const uint64_t active_work_items = std::max<uint64_t>(
      {1U, static_cast<uint64_t>(hkv), local_candidate_count,
       kv_group_count, (q_tail_jobs + 1U) / 2U});
  const uint32_t available_aic_cores = CubeCoreCount(q);
  const uint32_t active_aic_cores = static_cast<uint32_t>(
      std::min<uint64_t>(available_aic_cores, active_work_items));
  // Two KV tiles per active AIC balance the folded candidate schedule.
  // Workspace capacity includes the extra rows needed by a partial tile.
  const uint32_t color_chunk_base_rows = static_cast<uint32_t>(
      std::min<uint64_t>(2ULL * active_aic_cores * 128U,
                         color_chunk_capacity_rows));
  uint32_t color_chunk_rows = color_chunk_base_rows;
  const uint32_t color_chunk_promotion_limit =
      std::min<uint32_t>(
          color_chunk_capacity_rows,
          color_chunk_base_rows + kDkvColorChunkPromotionRows);
  if (color_chunk_rows > 0U &&
      color_chunk_promotion_limit > color_chunk_rows) {
    for (uint32_t i = 0U; i < batch; ++i) {
      const uint32_t kv_len =
          static_cast<uint32_t>(host_cu_kv[i + 1] - host_cu_kv[i]);
      const uint32_t wave_count = static_cast<uint32_t>(
          (static_cast<uint64_t>(kv_len) + color_chunk_base_rows - 1U) /
          color_chunk_base_rows);
      if (wave_count <= 1U ||
          wave_count > kDkvColorChunkPromotionMaxWaves) {
        continue;
      }
      const uint32_t tail_rows =
          kv_len - (wave_count - 1U) * color_chunk_base_rows;
      if (tail_rows > kDkvColorChunkPromotionTailRows) {
        continue;
      }
      const uint32_t reduced_wave_count = wave_count - 1U;
      const uint32_t required_rows = static_cast<uint32_t>(
          ((static_cast<uint64_t>(kv_len) + reduced_wave_count - 1U) /
               reduced_wave_count +
           127U) /
          128U * 128U);
      if (required_rows <= color_chunk_promotion_limit) {
        color_chunk_rows = std::max(color_chunk_rows, required_rows);
      }
    }
  }
  const uint64_t chunk_dk_storage_elems =
      (static_cast<uint64_t>(color_chunk_rows) + 127U) * hkv * kDim;
  const uint64_t batch_color_dk_storage_elems =
      packed_color_storage_rows * hkv * kDim;

  const bool use_dkv_color_partials =
      window_left > 0 && global_window == 0 && max_q_len > 0U && color_count > 1U &&
      dk_storage_elems <= color_workspace_limit_elems / (2U * color_count);
  const bool use_batch_dkv_color_partials =
      window_left > 0 && max_q_len > 0U && color_count > 1U &&
      !use_dkv_color_partials &&
      batch_dk_storage_elems <=
          color_workspace_limit_elems / (2U * color_count);
  const bool pack_batch_dkv_color_partials =
      use_batch_dkv_color_partials &&
      hkv <= 3U &&
      batch_dk_storage_elems <=
          packed_color_storage_rows * hkv * kDim;
  const bool use_chunked_dkv_color_partials =
      window_left > 0 && max_q_len > 0U && color_count > 1U &&
      !use_dkv_color_partials &&
      !use_batch_dkv_color_partials && color_chunk_rows >= 128U;
  const bool use_dkv_color_path =
      use_dkv_color_partials || use_batch_dkv_color_partials ||
      use_chunked_dkv_color_partials;
  const bool direct_dkv_output =
      global_window <= 128 &&
      (use_batch_dkv_color_partials || use_chunked_dkv_color_partials);
  const bool use_compact_chunk_dq =
      global_window == 0 && direct_dkv_output &&
      use_chunked_dkv_color_partials;
  const bool use_compact_batch_dq =
      global_window == 0 && direct_dkv_output &&
      use_batch_dkv_color_partials;
  const uint64_t dq_ring_rows =
      use_compact_chunk_dq ?
          static_cast<uint64_t>(color_chunk_rows) +
              ((local_radius + 127U) / 128U) * 128U :
      use_compact_batch_dq ?
          static_cast<uint64_t>(batch) * 128U : 0U;
  const uint64_t physical_dq_workspace_elems =
      (use_compact_chunk_dq || use_compact_batch_dq) ?
          dq_ring_rows * hq * kDim : dq_storage_elems;
  const uint64_t physical_workspace_elems =
      direct_dkv_output && global_window == 0 ?
          physical_dq_workspace_elems : workspace_elems;
  const uint64_t dkv_scratch_elems =
      active_aic_cores * kDkvScratchSlots * kDkvGradKinds * 128ULL * kDim;
  const bool use_direct_global_dq =
      global_window > 0 && global_window <= 128 &&
      max_q_len > local_radius + 128U &&
      static_cast<uint64_t>(batch) * 2U >= active_aic_cores &&
      use_dkv_color_path && !use_chunked_dkv_color_partials;
  const uint64_t dkv_color_elems =
      use_dkv_color_partials ?
          color_count * 2U * dk_storage_elems :
      pack_batch_dkv_color_partials ?
          color_count * 2U * batch_color_dk_storage_elems :
      use_batch_dkv_color_partials ?
          color_count * 2U * batch_dk_storage_elems :
      use_chunked_dkv_color_partials ?
          color_count * 2U * chunk_dk_storage_elems : 0U;
  uint64_t global_partial_rows = 0U;
  for (uint32_t i = 0U; i < batch; ++i) {
    const uint64_t q_len =
        static_cast<uint64_t>(host_cu_q[i + 1] - host_cu_q[i]);
    const uint64_t kv_len =
        static_cast<uint64_t>(host_cu_kv[i + 1] - host_cu_kv[i]);
    if (q_len == 0U || kv_len < q_len || global_window == 0 ||
        kv_len <= static_cast<uint64_t>(window_left)) {
      continue;
    }
    const uint64_t gap_rows = std::min<uint64_t>(
        static_cast<uint64_t>(global_window),
        kv_len - static_cast<uint64_t>(window_left));
    global_partial_rows += ((gap_rows + 127U) / 128U) * 128U;
  }
  const uint64_t global_dkv_plane_elems =
      global_partial_rows * hkv * kDim;
  const uint32_t global_dkv_partial_core_count =
      global_dkv_plane_elems > 0U ? active_aic_cores : 0U;
  const uint64_t global_dkv_partial_elems =
      2U * global_dkv_partial_core_count * global_dkv_plane_elems;
  const uint64_t reserved_workspace_elems =
      kReservedWorkspaceBytes / sizeof(float);
  auto workspace_storage = at::empty(
      {static_cast<int64_t>(
          reserved_workspace_elems + physical_workspace_elems +
          dkv_scratch_elems + dkv_color_elems +
          global_dkv_partial_elems)},
      q.options().dtype(at::kFloat));
  auto workspace = workspace_storage.narrow(
      0, static_cast<int64_t>(reserved_workspace_elems),
      static_cast<int64_t>(physical_workspace_elems));
  auto npu_stream = c10_npu::getCurrentNPUStream(q.device().index());
  auto stream = npu_stream.stream(true);

  swa_v5_backward_bf16<<<active_aic_cores, nullptr, stream>>>(
      static_cast<uint8_t *>(q.data_ptr()), static_cast<uint8_t *>(k.data_ptr()),
      static_cast<uint8_t *>(v.data_ptr()), static_cast<uint8_t *>(out.data_ptr()),
      static_cast<uint8_t *>(dout.data_ptr()), static_cast<uint8_t *>(softmax_lse.data_ptr()),
      static_cast<uint8_t *>(dq.data_ptr()), static_cast<uint8_t *>(dk.data_ptr()),
      static_cast<uint8_t *>(dv.data_ptr()), static_cast<uint8_t *>(workspace_storage.data_ptr()),
      static_cast<uint8_t *>(cu_q_lens.data_ptr()), static_cast<uint8_t *>(cu_kv_lens.data_ptr()),
      batch, hq, hkv, total_q_tokens, total_kv_tokens,
      max_q_len, max_kv_len, static_cast<uint32_t>(window_left), 0U,
      static_cast<uint32_t>(global_window), static_cast<uint32_t>(gqa_layout),
      active_aic_cores, kDim, static_cast<float>(scale),
      out.scalar_type() == at::kFloat ? 1U : 0U, color_chunk_rows);
  for (const auto &tensor : {q, k, v, out, dout, softmax_lse, dq, dk, dv,
                             workspace_storage, cu_q_lens, cu_kv_lens}) {
    c10_npu::NPUCachingAllocator::recordStream(tensor.storage().data_ptr(), npu_stream);
  }

  return {dq, dk, dv, workspace};
}

}  // namespace mojo::native
