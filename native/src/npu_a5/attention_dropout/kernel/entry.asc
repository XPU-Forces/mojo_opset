#include "../../mxfp8_quantize_sr/kernel/sr8.h"

// Reuse the native Philox4x32-10 primitive. Random words stay in registers;
// only the 1-bit Bernoulli decisions are written to global memory.
namespace AttentionDropout {
using namespace AscendC;
using U = Reg::RegTensor<uint32_t>;

__simd_callee__ inline void PackPair(__ubuf__ uint8_t* out, U& a, U& b, uint32_t threshold) {
    auto valid = Reg::CreateMask<uint16_t>();
    Reg::MaskReg ca, cb, pa, pb, packed, unused;
    // Keep the packet layout, but use eight independent random bits per draw.
    // FA2/Blackstone keep uint8 <= floor((1-p) * 255).
    U bytes, low_a, low_b;
    auto words = Reg::CreateMask<uint32_t>();
    Reg::Duplicate(bytes, uint32_t(0x00ff00ff));
    Reg::And(low_a, a, bytes, words);
    Reg::And(low_b, b, bytes, words);
    Reg::CompareScalar<uint16_t, CMPMODE::LE>(ca, (Reg::RegTensor<uint16_t>&)low_a, uint16_t(threshold), valid);
    Reg::CompareScalar<uint16_t, CMPMODE::LE>(cb, (Reg::RegTensor<uint16_t>&)low_b, uint16_t(threshold), valid);
    Reg::Pack(pa, ca);
    Reg::Pack(pb, cb);
    // Each packed predicate contains 128 decisions. Interleave the two lower
    // halves to make one complete 256-bit store, with no partial/overlap stores.
    Reg::Interleave<uint8_t>(packed, unused, pa, pb);
    Reg::StoreAlign(out, packed);
}

class Kernel {
    static constexpr uint32_t TileBytes = 4096;
    TPipe pipe;
    TQue<QuePosition::VECOUT, 2> output;
public:
    __aicore__ inline void Run(GM_ADDR seed, GM_ADDR dst, uint64_t bytes, uint32_t threshold) {
        GlobalTensor<uint32_t> keys;
        keys.SetGlobalBuffer((__gm__ uint32_t*)seed);
        const uint32_t key0 = keys.GetValue(0), key1 = keys.GetValue(1);
        GlobalTensor<uint8_t> gm;
        gm.SetGlobalBuffer((__gm__ uint8_t*)dst);
        pipe.InitBuffer(output, 2, TileBytes);
        const uint64_t tasks = (bytes + TileBytes - 1) / TileBytes;
        const uint64_t begin = tasks * GetBlockIdx() / GetBlockNum();
        const uint64_t end = tasks * (GetBlockIdx() + 1) / GetBlockNum();
        for (uint64_t tile = begin; tile < end; ++tile) {
            const uint64_t offset = tile * TileBytes;
            const uint32_t size = uint32_t(bytes - offset < TileBytes ? bytes - offset : TileBytes);
            const uint16_t packets = uint16_t((size + 63) / 64);
            auto data = output.AllocTensor<uint8_t>();
            auto ptr = (__ubuf__ uint8_t*)data.GetPhyAddr();
            __VEC_SCOPE__ {
                U a, b, c, d;
                for (uint16_t i = 0; i < packets; ++i) {
                    // 64 counters yield 512 8-bit draws in uint16 lanes, i.e. 64 output bytes.
                    Sr8::Words(a, b, c, d, uint32_t(offset) + uint32_t(i) * 64, 16, key0, key1, false);
                    PackPair(ptr + uint32_t(i) * 64, a, b, threshold);
                    PackPair(ptr + uint32_t(i) * 64 + 32, c, d, threshold);
                }
            }
            output.EnQue(data);
            data = output.DeQue<uint8_t>();
            DataCopyExtParams cp = {1, size, 0, 0, 0};
            DataCopyPad(gm[offset], data, cp);
            output.FreeTensor(data);
        }
    }
};
} // namespace AttentionDropout

extern "C" __global__ __aicore__ void attention_dropout_kernel(
    GM_ADDR seed, GM_ADDR output, uint64_t bytes, uint32_t threshold) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    AttentionDropout::Kernel kernel;
    kernel.Run(seed, output, bytes, threshold);
}

extern "C" void LaunchAttentionDropout(
    uint32_t blocks, void* stream, void* seed, void* output, uint64_t bytes, uint32_t threshold) {
    attention_dropout_kernel<<<blocks, nullptr, stream>>>((uint8_t*)seed, (uint8_t*)output, bytes, threshold);
}
