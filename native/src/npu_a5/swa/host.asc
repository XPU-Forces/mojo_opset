#include "host.h"
#include "common/npu.h"

#include <c10/core/DeviceGuard.h>
#include <torch_npu/csrc/core/npu/NPUCachingAllocator.h>
#include <torch_npu/csrc/core/npu/NPUStream.h>

#include "acl/acl.h"

#include <algorithm>
#include <cmath>
#include <cstdint>
#include <limits>
#include <type_traits>
#include <tuple>
#include <vector>

#define SWA_V5_ENTRY_KERNEL swa_v5_mojo_bf16
#define SWA_V5_ENTRY_DIM 128
#define SWA_V5_ENTRY_IS_FORWARD 1
#define SWA_V5_ENTRY_IS_CAUSAL 1
#define SWA_V5_ENTRY_OUTPUT_FP16 0
#define SWA_V5_ENTRY_INPUT_BF16 1
#define SWA_V5_ENTRY_OUTPUT_BF16 1
#include "kernel/entry.cpp"

namespace mojo::native {
namespace {

constexpr uint32_t kDim = 128;
constexpr uint32_t kGqaLayoutAabb = 0;
constexpr uint32_t kGqaLayoutAbab = 1;
constexpr uint32_t kWindowRight = 0;
constexpr uint32_t kDeepVec2QueueMinTokens = 1;

uint32_t CubeCoreCount(const at::Tensor &tensor) {
  struct CachedCoreCount {
    int64_t device = -1;
    uint32_t cores = 0;
  };
  thread_local CachedCoreCount cache;
  const int64_t device = tensor.device().index();
  if (cache.device == device) {
    return cache.cores;
  }
  int64_t cores = 0;
  TORCH_CHECK(aclrtGetDeviceInfo(device, ACL_DEV_ATTR_CUBE_CORE_NUM, &cores) == ACL_SUCCESS &&
                  cores > 0 && cores <= std::numeric_limits<uint32_t>::max(),
              "failed to query NPU Cube core count");
  cache = {device, static_cast<uint32_t>(cores)};
  return cache.cores;
}

void ValidateInputs(const at::Tensor &query, const at::Tensor &key, const at::Tensor &value, const at::Tensor &cu_q_lens,
                    const at::Tensor &cu_kv_lens, bool is_causal, int64_t local_window_size,
                    int64_t global_window_size, int64_t gqa_layout) {
  TORCH_CHECK(query.device().type() == c10::DeviceType::PrivateUse1 &&
                  key.device().type() == c10::DeviceType::PrivateUse1 &&
                  value.device().type() == c10::DeviceType::PrivateUse1,
              "query/key/value must be NPU tensors");
  TORCH_CHECK(query.is_contiguous() && key.is_contiguous() && value.is_contiguous(),
              "query/key/value must be contiguous");
  TORCH_CHECK(query.dim() == 3 && key.dim() == 3 && value.dim() == 3,
              "query/key/value must be packed TND tensors");
  TORCH_CHECK(query.scalar_type() == at::kBFloat16, "SWA AscendC path currently supports BF16 only");
  TORCH_CHECK(key.scalar_type() == query.scalar_type() && value.scalar_type() == query.scalar_type(),
              "query/key/value dtype must match");
  TORCH_CHECK(query.size(2) == kDim && key.size(2) == kDim && value.size(2) == kDim, "head_dim must be 128");
  TORCH_CHECK(key.size(0) == value.size(0) && key.size(1) == value.size(1), "key/value shapes are inconsistent");
  TORCH_CHECK(key.size(1) > 0 && query.size(1) > 0 && query.size(1) % key.size(1) == 0,
              "Hq must be positive and divisible by Hkv > 0");
  TORCH_CHECK(query.device() == key.device() && query.device() == value.device() &&
                  query.device() == cu_q_lens.device() && query.device() == cu_kv_lens.device(),
              "all SWA tensors must be on the same NPU device");
  TORCH_CHECK(cu_q_lens.is_contiguous() && cu_kv_lens.is_contiguous(), "cu_lens must be contiguous");
  TORCH_CHECK(cu_q_lens.scalar_type() == at::kInt && cu_kv_lens.scalar_type() == at::kInt,
              "cu_q_lens/cu_total_seq_lens must be int32");
  TORCH_CHECK(cu_q_lens.dim() == 1 && cu_kv_lens.dim() == 1 && cu_q_lens.numel() == cu_kv_lens.numel(),
              "cu_q_lens/cu_total_seq_lens must be 1-D tensors with the same length");
  TORCH_CHECK(is_causal, "SWA AscendC path currently supports causal mode only");
  TORCH_CHECK(cu_q_lens.numel() >= 2, "cu_lens must describe at least one sequence");
  TORCH_CHECK(local_window_size >= 0 || global_window_size > 0,
              "SWA AscendC path requires a local or global window");
  TORCH_CHECK(local_window_size >= -1, "local_window_size must be a radius or -1 for disabled");
  TORCH_CHECK(global_window_size >= 0, "global_window_size must be non-negative");
  TORCH_CHECK(gqa_layout == kGqaLayoutAabb || gqa_layout == kGqaLayoutAbab, "invalid gqa_layout");
}

}  // namespace

static std::tuple<at::Tensor, at::Tensor, at::Tensor> LaunchSwaCurrentStreamImpl(
    const at::Tensor &query, const at::Tensor &key, const at::Tensor &value,
    const at::Tensor &cu_q_lens, const at::Tensor &cu_kv_lens, bool is_causal,
    int64_t local_window_size_arg, int64_t global_window_size_arg, double scale,
    int64_t gqa_layout, bool output_f32, int64_t block_dim_arg, bool legacy_infer) {
  ValidateInputs(query, key, value, cu_q_lens, cu_kv_lens, is_causal, local_window_size_arg, global_window_size_arg,
                 gqa_layout);
  const c10::DeviceGuard device_guard(query.device());
  const uint32_t available_cores = CubeCoreCount(query);
  TORCH_CHECK(block_dim_arg >= 0 && static_cast<uint64_t>(block_dim_arg) <= available_cores,
              "block_dim must be zero or no greater than the device Cube core count");
  TORCH_CHECK(std::isfinite(scale) && scale > 0.0 && scale <= std::numeric_limits<float>::max(),
              "softmax_scale must be finite, positive, and representable as float");
  if (legacy_infer) {
    // Keep the migration API's original rejection contract separate from F.swa.
    TORCH_CHECK(local_window_size_arg > 0,
                "SWA AscendC path requires a positive local_window_size");
    TORCH_CHECK(global_window_size_arg == 4,
                "SWA AscendC path currently supports global_window_size=4");
    TORCH_CHECK(std::abs(scale - 0.08838834764831845) < 1e-12,
                "SWA AscendC kernel currently requires softmax_scale=1/sqrt(128)");
    TORCH_CHECK(block_dim_arg == 0 || block_dim_arg == 28,
                "native_swa_infer requires block_dim=0 or 28");
    const bool supported_heads =
        (query.size(1) == 16 && key.size(1) == 4) ||
        (query.size(1) == 8 && key.size(1) == 1);
    const bool supported_window =
        (gqa_layout == kGqaLayoutAabb && local_window_size_arg == 1023) ||
        (gqa_layout == kGqaLayoutAbab && local_window_size_arg == 255);
    TORCH_CHECK(supported_heads && supported_window,
                "unsupported SWA AscendC specialization");
  }

  const auto host_cu_q = ReadCuLens(cu_q_lens);
  const auto host_cu_kv =
      cu_q_lens.is_same(cu_kv_lens) ? host_cu_q : ReadCuLens(cu_kv_lens);
  const uint32_t batch = static_cast<uint32_t>(cu_q_lens.numel() - 1);
  uint32_t max_q_len = 0;
  uint32_t max_kv_len = 0;
  for (uint32_t i = 0; i < batch; ++i) {
    TORCH_CHECK(host_cu_q[i + 1] > host_cu_q[i] && host_cu_kv[i + 1] > host_cu_kv[i],
                "each sequence must have positive q and kv lengths");
    TORCH_CHECK(host_cu_kv[i + 1] - host_cu_kv[i] >= host_cu_q[i + 1] - host_cu_q[i],
                "SWA requires kv length >= q length for each sequence");
    max_q_len = std::max(max_q_len, static_cast<uint32_t>(host_cu_q[i + 1] - host_cu_q[i]));
    max_kv_len = std::max(max_kv_len, static_cast<uint32_t>(host_cu_kv[i + 1] - host_cu_kv[i]));
  }
  TORCH_CHECK(host_cu_q.front() == 0 && host_cu_kv.front() == 0, "cu_lens must start at zero");
  TORCH_CHECK(host_cu_q.back() == query.size(0) && host_cu_kv.back() == key.size(0), "cu_lens do not match tokens");
  TORCH_CHECK(value.size(0) == key.size(0), "value token count must match key token count");
  TORCH_CHECK(max_q_len > 0 && max_kv_len > 0, "empty SWA input is not supported");
  if (legacy_infer) {
    TORCH_CHECK(max_q_len <= 1024 && max_kv_len <= 9216,
                "SWA sequence length exceeds compiled limits");
  }
  TORCH_CHECK(host_cu_q.back() <= std::numeric_limits<uint32_t>::max() &&
                  host_cu_kv.back() <= std::numeric_limits<uint32_t>::max(),
              "total token count exceeds uint32_t range");

  const uint32_t num_q_heads = static_cast<uint32_t>(query.size(1));
  const uint32_t num_kv_heads = static_cast<uint32_t>(key.size(1));
  // Kernel encoding: 0 disables local; a positive span includes the query itself.
  uint32_t window_left = local_window_size_arg < 0 ? 0U :
      static_cast<uint32_t>(
          std::min<int64_t>(local_window_size_arg, max_kv_len - 1U)) + 1U;
  uint32_t global_window_size = static_cast<uint32_t>(
      std::min<int64_t>(global_window_size_arg, max_kv_len));
  // The query token belongs to the local window only when it is enabled.
  if (global_window_size >= max_kv_len ||
      (window_left > 0U &&
       static_cast<uint64_t>(window_left) + global_window_size >=
           max_kv_len)) {
    window_left = max_kv_len;
    global_window_size = 0U;
  }
  const uint32_t block_dim =
      block_dim_arg == 0 ? available_cores : static_cast<uint32_t>(block_dim_arg);

  auto output = at::empty_like(query);
  auto output_cache = output_f32
      ? at::empty(query.sizes(), query.options().dtype(at::kFloat))
      : at::empty({0}, query.options().dtype(at::kFloat));
  auto lse = at::empty({query.size(1), query.size(0)}, query.options().dtype(at::kFloat));
  auto npu_stream = c10_npu::getCurrentNPUStream(query.device().index());
  auto stream = npu_stream.stream(false);

  auto launch_chunks = [&](auto capacity_tag) {
    constexpr uint32_t capacity = decltype(capacity_tag)::value;
    for (uint32_t batch_begin = 0U; batch_begin < batch;
         batch_begin += capacity) {
      const uint32_t launch_batch =
          std::min(batch - batch_begin, capacity);
      SWA_v5::Pipeline::FullPath::TaskMetadata<capacity> task_metadata{};
      task_metadata.batch_begin = batch_begin;
      for (uint32_t i = 0U; i <= launch_batch; ++i) {
        task_metadata.q_lens[i] =
            static_cast<uint32_t>(host_cu_q[batch_begin + i]);
        task_metadata.kv_lens[i] =
            static_cast<uint32_t>(host_cu_kv[batch_begin + i]);
      }
      auto launch_kernel = [&](auto queue_depth_tag, auto output_cache_tag) {
        constexpr uint32_t queue_depth = decltype(queue_depth_tag)::value;
        constexpr bool write_output_cache = decltype(output_cache_tag)::value;
        swa_v5_mojo_bf16<capacity, queue_depth, write_output_cache><<<block_dim, nullptr, stream>>>(
            static_cast<uint8_t *>(query.data_ptr()),
            static_cast<uint8_t *>(key.data_ptr()),
            static_cast<uint8_t *>(value.data_ptr()),
            static_cast<uint8_t *>(output.data_ptr()),
            static_cast<uint8_t *>(output_cache.data_ptr()),
            static_cast<uint8_t *>(lse.data_ptr()), task_metadata, launch_batch,
            num_q_heads, num_kv_heads,
            static_cast<uint32_t>(host_cu_q.back()),
            static_cast<uint32_t>(host_cu_kv.back()), max_q_len, max_kv_len,
            window_left, kWindowRight, global_window_size,
            static_cast<uint32_t>(gqa_layout), block_dim, kDim,
            static_cast<float>(scale));
      };
      auto launch_depth = [&](auto queue_depth_tag) {
        if (output_f32) {
          launch_kernel(queue_depth_tag, std::true_type{});
        } else {
          launch_kernel(queue_depth_tag, std::false_type{});
        }
      };
      if (host_cu_q.back() < kDeepVec2QueueMinTokens) {
        launch_depth(std::integral_constant<uint32_t, 2U>{});
      } else {
        launch_depth(std::integral_constant<uint32_t, 3U>{});
      }
    }
  };
  if (batch <= 16U) {
    launch_chunks(std::integral_constant<uint32_t, 16U>{});
  } else {
    launch_chunks(std::integral_constant<uint32_t, 128U>{});
  }
  for (const auto &tensor : {query, key, value, output, output_cache, lse, cu_q_lens, cu_kv_lens}) {
    c10_npu::NPUCachingAllocator::recordStream(tensor.storage().data_ptr(), npu_stream);
  }
  return {output, lse, output_cache};
}

std::tuple<at::Tensor, at::Tensor, at::Tensor> LaunchSwaTrainingCurrentStream(
    const at::Tensor &query, const at::Tensor &key, const at::Tensor &value,
    const at::Tensor &cu_q_lens, const at::Tensor &cu_kv_lens, bool is_causal,
    int64_t local_window_size_arg, int64_t global_window_size_arg, double scale,
    int64_t gqa_layout, bool output_f32, int64_t block_dim_arg) {
  return LaunchSwaCurrentStreamImpl(
      query, key, value, cu_q_lens, cu_kv_lens, is_causal, local_window_size_arg,
      global_window_size_arg, scale, gqa_layout, output_f32, block_dim_arg, false);
}

at::Tensor LaunchSwaCurrentStream(const at::Tensor &query, const at::Tensor &key, const at::Tensor &value,
                                  const at::Tensor &cu_q_lens, const at::Tensor &cu_kv_lens, bool is_causal,
                                  int64_t local_window_size_arg, int64_t global_window_size_arg, double scale,
                                  int64_t gqa_layout, int64_t block_dim_arg) {
  return std::get<0>(LaunchSwaCurrentStreamImpl(
      query, key, value, cu_q_lens, cu_kv_lens, is_causal, local_window_size_arg,
      global_window_size_arg, scale, gqa_layout, false, block_dim_arg, true));
}

}  // namespace mojo::native
