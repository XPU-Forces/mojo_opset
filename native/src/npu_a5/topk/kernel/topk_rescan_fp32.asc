#include "launch.h"

#include <kernel_operator.h>
#include <simt_api/asc_simt.h>
#include <simt_api/device_warp_functions.h>

using namespace AscendC;

namespace mojo::native::a5 {
namespace {
constexpr uint32_t kThreads = 512;
constexpr uint32_t kWarps = kThreads / 32;

__simt_callee__ inline uint32_t OrderKey(uint32_t raw) {
    if ((raw & 0x7fffffffU) == 0) return 0x80000000U;
    return raw ^ ((raw & 0x80000000U) ? 0xffffffffU : 0x80000000U);
}

template <uint32_t Chunks, bool FullBucket>
__simt_vf__ __aicore__ LAUNCH_BOUND(kThreads) void SmallTopKRescan(
    __gm__ const uint32_t* input, __gm__ uint32_t* values, __gm__ int64_t* indices,
    uint32_t begin, uint32_t end, uint32_t n, uint32_t k, uint64_t input_stride, uint64_t value_stride,
    uint64_t index_stride, __ubuf__ uint32_t* nan_flags) {
    static_assert(Chunks == 8 || Chunks == 16 || Chunks == 20 || Chunks == 32);
    constexpr uint32_t GuaranteedChunks = FullBucket ? Chunks :
        (Chunks == 8 ? 0 : Chunks == 16 ? 8 : Chunks == 20 ? 16 : 20);
    const uint32_t lane = threadIdx.x & 31U;
    const uint32_t warp = threadIdx.x >> 5;
    if (lane == 0) nan_flags[warp * 8] = 0;
    for (uint32_t row = begin + warp; row < end; row += kWarps) {
        const uint64_t source = uint64_t(row) * input_stride;
        uint32_t keys[Chunks], nan_found = 0, selected_index = 0;
#pragma unroll
        for (uint32_t j = 0; j < GuaranteedChunks; ++j) {
            uint32_t raw = input[source + j * 32 + lane];
            nan_found |= (raw & 0x7fffffffU) > 0x7f800000U;
            keys[j] = OrderKey(raw);
        }
#pragma unroll
        for (uint32_t j = GuaranteedChunks; j < Chunks; ++j) {
            uint32_t index = j * 32 + lane;
            uint32_t key = 0;
            if (index < n) {
                uint32_t raw = input[source + index];
                nan_found |= (raw & 0x7fffffffU) > 0x7f800000U;
                key = OrderKey(raw);
            }
            keys[j] = key;
        }
        if (asc_reduce_max(nan_found)) {
            if (lane == 0) nan_flags[warp * 8] = 1;
            if (lane < k) {
                indices[uint64_t(row) * index_stride + lane] = int64_t(0x3f3f3f3f);
                values[uint64_t(row) * value_stride + lane] = 0x7fc00000U;
            }
            continue;
        }
        for (uint32_t rank = 0; rank < k; ++rank) {
            uint32_t best_key = 0, best_index = 0xffffffffU;
#pragma unroll
            for (uint32_t j = 0; j < Chunks; ++j) {
                uint32_t key = keys[j], index = j * 32 + lane;
                bool better = key > best_key || (key == best_key && index < best_index);
                best_key = better ? key : best_key;
                best_index = better ? index : best_index;
            }
            uint32_t global_key = asc_reduce_max(best_key);
            uint32_t global_index = asc_reduce_min(best_key == global_key ? best_index : 0xffffffffU);
            if (lane == rank) selected_index = global_index;
#pragma unroll
            for (uint32_t j = 0; j < Chunks; ++j)
                keys[j] = global_index == j * 32 + lane ? 0U : keys[j];
        }
        if (lane < k) {
            values[uint64_t(row) * value_stride + lane] = input[source + selected_index];
            indices[uint64_t(row) * index_stride + lane] = int64_t(selected_index);
        }
    }
}

template <uint32_t Chunks, bool FullBucket>
__global__ __vector__ __aicore__ void topk_rescan_kernel(const TopkSelectArgs args, uint32_t cores) {
    InitSocState();
    uint32_t rows_per_core = (args.batch_size + cores - 1) / cores;
    uint32_t begin = get_block_idx() * rows_per_core;
    uint32_t end = begin + rows_per_core < args.batch_size ? begin + rows_per_core : args.batch_size;
    auto* nan_flags = reinterpret_cast<__ubuf__ uint32_t*>(0);
    asc_vf_call<SmallTopKRescan<Chunks, FullBucket>>(dim3(kThreads), reinterpret_cast<__gm__ const uint32_t*>(args.input),
        reinterpret_cast<__gm__ uint32_t*>(args.output_value), reinterpret_cast<__gm__ int64_t*>(args.output_index),
        begin, end, args.vocab_size, args.topk, args.stride_input_batch, args.stride_output_value_batch,
        args.stride_output_index_batch, nan_flags);
    if (args.abort_when_nan_found) {
        set_flag(PIPE_V, PIPE_S, event_t(0));
        wait_flag(PIPE_V, PIPE_S, event_t(0));
        for (uint32_t warp = 0; warp < kWarps; ++warp)
            if (nan_flags[warp * 8]) trap();
    }
}
}

void LaunchRescanTopK(const TopkSelectArgs& args, uint32_t cores) {
    auto launch = [&]<uint32_t Chunks>() {
        if (args.vocab_size == Chunks * 32)
            topk_rescan_kernel<Chunks, true><<<cores, 1024, args.stream>>>(args, cores);
        else
            topk_rescan_kernel<Chunks, false><<<cores, 1024, args.stream>>>(args, cores);
    };
    if (args.vocab_size <= 256) launch.template operator()<8>();
    else if (args.vocab_size <= 512) launch.template operator()<16>();
    else if (args.vocab_size <= 640) launch.template operator()<20>();
    else launch.template operator()<32>();
}
}
